<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>World Weather Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: '#6366f1',
            secondary: '#8b5cf6',
          }
        }
      }
    }
  </script>
  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }
    .float { animation: float 3s ease-in-out infinite; }
  </style>
  <script>
    // Apply theme from localStorage before page renders to avoid flash
    (function() {
      const theme = localStorage.getItem('theme') || 'dark';
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>
</head>
<body class="min-h-screen font-sans antialiased bg-gray-100 dark:bg-gradient-to-br dark:from-slate-900 dark:via-indigo-950 dark:to-slate-900 transition-colors duration-300">
  
  <!-- Header -->
  <header class="backdrop-blur-md bg-white/80 dark:bg-white/5 border-b border-gray-200 dark:border-white/10">
    <div class="container mx-auto px-4 py-5">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-indigo-100 dark:bg-white/10 rounded-lg flex items-center justify-center backdrop-blur-sm">
            <span class="text-2xl">🌍</span>
          </div>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight">World Weather Dashboard</h1>
        </div>
        <div class="flex items-center space-x-4">
          <!-- Theme Toggle -->
          <button id="theme-toggle" class="w-10 h-10 bg-gray-200 dark:bg-white/10 rounded-lg flex items-center justify-center hover:bg-gray-300 dark:hover:bg-white/20 transition-colors" title="Toggle theme">
            <svg class="w-5 h-5 text-yellow-500 hidden dark:block" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path>
            </svg>
            <svg class="w-5 h-5 text-gray-700 block dark:hidden" fill="currentColor" viewBox="0 0 20 20">
              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
            </svg>
          </button>
          <div class="hidden md:flex items-center space-x-2 text-gray-600 dark:text-white/80 text-sm bg-gray-200 dark:bg-white/10 px-4 py-2 rounded-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span><%= dateTime.date %></span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="container mx-auto px-4 py-6">
    <!-- Date display for mobile -->
    <div class="md:hidden text-center mb-4">
      <p class="text-gray-600 dark:text-white/80 text-sm bg-gray-200 dark:bg-white/10 inline-block px-4 py-2 rounded-lg"><%= dateTime.date %></p>
    </div>

    <!-- Cities Grid -->
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <% cities.forEach(function(city) { %>
          <a href="/city/<%= city.id %>" target="_blank" class="block backdrop-blur-xl bg-white dark:bg-white/5 rounded-2xl p-5 border border-gray-200 dark:border-white/10 hover:border-indigo-500/50 hover:shadow-lg dark:hover:bg-white/10 transition-all duration-200 group">
            <div class="flex items-center justify-between mb-3">
              <span class="text-gray-900 dark:text-white font-semibold"><%= city.name %></span>
              <span id="card-emoji-<%= city.id %>" class="text-2xl">⏳</span>
            </div>
            <p class="text-xs text-indigo-600 dark:text-indigo-400 font-medium mb-1"><%= city.continent %></p>
            <p id="card-time-<%= city.id %>" class="text-indigo-600 dark:text-indigo-300 text-sm font-mono">--:--</p>
            <p id="card-temp-<%= city.id %>" class="text-gray-900 dark:text-white font-bold text-2xl mt-2">--°C</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 group-hover:text-indigo-500 dark:group-hover:text-indigo-400 transition-colors">View forecast →</p>
          </a>
        <% }); %>
      </div>
    </div>

    <!-- Footer -->
    <div class="mt-8 max-w-6xl mx-auto">
      <div class="backdrop-blur-xl bg-white dark:bg-white/5 rounded-2xl p-5 border border-gray-200 dark:border-white/10">
        <div class="flex flex-col md:flex-row items-center justify-between space-y-3 md:space-y-0">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-lg flex items-center justify-center">
              <span class="text-sm">🌐</span>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-700 dark:text-white/80">Powered by Open-Meteo</p>
              <p class="text-xs text-gray-500 dark:text-gray-400">Free open-source weather API</p>
            </div>
          </div>
          <button onclick="location.reload()" class="inline-flex items-center space-x-2 px-4 py-2 bg-gradient-to-r from-indigo-500 to-purple-600 text-white rounded-lg hover:from-indigo-600 hover:to-purple-700 transition-all duration-200 shadow-md text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            <span>Refresh</span>
          </button>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Theme toggle
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle.addEventListener('click', function() {
      const html = document.documentElement;
      if (html.classList.contains('dark')) {
        html.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        html.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });

    // City data from server
    const cities = <%- JSON.stringify(cities) %>;
    let weatherData = {};

    // Update local times for all cities
    function updateCityTimes() {
      cities.forEach(city => {
        try {
          const now = new Date();
          const timeStr = now.toLocaleTimeString('en-US', {
            timeZone: city.timezone,
            hour: '2-digit',
            minute: '2-digit',
            hour12: true
          });
          const cardTimeEl = document.getElementById('card-time-' + city.id);
          if (cardTimeEl) cardTimeEl.textContent = timeStr;
        } catch (e) {
          // Timezone not supported in this browser
        }
      });
    }

    // Fetch weather data
    async function fetchWeather() {
      try {
        const response = await fetch('/api/weather');
        const data = await response.json();
        weatherData = {};
        data.forEach(item => {
          weatherData[item.id] = item;
          // Update city cards
          const emojiEl = document.getElementById('card-emoji-' + item.id);
          const tempEl = document.getElementById('card-temp-' + item.id);
          if (emojiEl && item.emoji) emojiEl.textContent = item.emoji;
          if (tempEl && item.temperature !== null) tempEl.textContent = item.temperature + '°C';
        });
      } catch (e) {
        console.error('Failed to fetch weather:', e);
      }
    }

    // Initialize
    updateCityTimes();
    setInterval(updateCityTimes, 1000);
    fetchWeather();
    // Refresh weather every 5 minutes
    setInterval(fetchWeather, 300000);
  </script>
</body>
</html>
