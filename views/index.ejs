<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>World Weather Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#6366f1',
            secondary: '#8b5cf6',
          }
        }
      }
    }
  </script>
  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }
    @keyframes pulse-dot {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.5); opacity: 0.5; }
    }
    .float { animation: float 3s ease-in-out infinite; }
    .pulse-dot { animation: pulse-dot 2s ease-in-out infinite; }
    .city-marker { cursor: pointer; transition: transform 0.2s; }
    .city-marker:hover { transform: scale(1.3); }
    .callout {
      position: absolute;
      z-index: 50;
      pointer-events: none;
      opacity: 0;
      transform: translateY(5px);
      transition: opacity 0.2s, transform 0.2s;
    }
    .callout.visible {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .map-container {
      position: relative;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 min-h-screen font-sans antialiased">
  
  <!-- Header -->
  <header class="backdrop-blur-md bg-white/5 border-b border-white/10">
    <div class="container mx-auto px-4 py-5">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center backdrop-blur-sm">
            <span class="text-2xl">🌍</span>
          </div>
          <h1 class="text-2xl font-bold text-white tracking-tight">World Weather Dashboard</h1>
        </div>
        <div class="flex items-center space-x-4">
          <div class="hidden md:flex items-center space-x-2 text-white/80 text-sm bg-white/10 px-4 py-2 rounded-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span><%= dateTime.date %></span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="container mx-auto px-4 py-6">
    <!-- Date display for mobile -->
    <div class="md:hidden text-center mb-4">
      <p class="text-white/80 text-sm bg-white/10 inline-block px-4 py-2 rounded-lg"><%= dateTime.date %></p>
    </div>

    <!-- World Map Section -->
    <div class="map-container" id="map-container">
      <div class="backdrop-blur-xl bg-white/5 rounded-3xl shadow-2xl overflow-hidden border border-white/10 p-4 md:p-8">
        <div class="relative" id="world-map-wrapper">
          <!-- SVG World Map -->
          <svg id="world-map" viewBox="0 0 1000 500" class="w-full h-auto" style="min-height: 300px;">
            <!-- Ocean background -->
            <rect width="1000" height="500" fill="#0f172a" rx="12"/>
            
            <!-- Grid lines -->
            <g stroke="#1e3a5f" stroke-width="0.5" opacity="0.3">
              <line x1="0" y1="250" x2="1000" y2="250"/>
              <line x1="500" y1="0" x2="500" y2="500"/>
              <line x1="0" y1="125" x2="1000" y2="125"/>
              <line x1="0" y1="375" x2="1000" y2="375"/>
              <line x1="250" y1="0" x2="250" y2="500"/>
              <line x1="750" y1="0" x2="750" y2="500"/>
            </g>

            <!-- Simplified continent outlines -->
            <!-- North America -->
            <path d="M 120,80 L 150,70 180,75 220,90 250,100 270,120 280,140 275,160 260,180 240,190 230,210 220,230 210,240 200,235 190,220 180,200 160,180 140,160 130,140 120,120 115,100 Z" 
                  fill="#1e3a5f" stroke="#2d5a8e" stroke-width="1" opacity="0.6"/>
            <!-- South America -->
            <path d="M 240,270 L 260,260 280,270 290,290 300,320 295,350 285,380 270,400 255,410 240,390 235,360 230,330 225,300 230,280 Z" 
                  fill="#1e3a5f" stroke="#2d5a8e" stroke-width="1" opacity="0.6"/>
            <!-- Europe -->
            <path d="M 440,80 L 470,75 500,80 530,85 550,95 545,110 535,125 520,130 500,135 480,130 460,120 450,105 445,90 Z" 
                  fill="#1e3a5f" stroke="#2d5a8e" stroke-width="1" opacity="0.6"/>
            <!-- Africa -->
            <path d="M 450,180 L 480,170 510,175 540,185 550,210 555,240 550,270 540,300 525,330 510,350 490,360 470,350 455,330 445,300 440,270 440,240 445,210 Z" 
                  fill="#1e3a5f" stroke="#2d5a8e" stroke-width="1" opacity="0.6"/>
            <!-- Asia -->
            <path d="M 560,70 L 600,60 650,65 700,70 750,80 790,100 810,120 800,140 780,160 750,175 720,180 690,185 660,180 630,170 600,155 580,140 565,120 555,100 Z" 
                  fill="#1e3a5f" stroke="#2d5a8e" stroke-width="1" opacity="0.6"/>
            <!-- Southeast Asia / Indonesia -->
            <path d="M 700,220 L 730,215 760,220 780,230 790,240 780,250 760,255 730,250 710,240 Z" 
                  fill="#1e3a5f" stroke="#2d5a8e" stroke-width="1" opacity="0.6"/>
            <!-- Australia -->
            <path d="M 770,320 L 810,310 850,315 880,330 890,355 880,380 860,395 830,400 800,395 780,380 770,355 Z" 
                  fill="#1e3a5f" stroke="#2d5a8e" stroke-width="1" opacity="0.6"/>

            <!-- City markers -->
            <% cities.forEach(function(city, index) { %>
              <% 
                // Convert lat/lon to SVG coordinates using Mercator-like projection
                const x = ((city.lon + 180) / 360) * 1000;
                const y = ((90 - city.lat) / 180) * 500;
              %>
              <g class="city-marker" data-city-id="<%= city.id %>" data-index="<%= index %>">
                <!-- Outer pulse ring -->
                <circle cx="<%= x %>" cy="<%= y %>" r="8" fill="none" stroke="#818cf8" stroke-width="1.5" class="pulse-dot" style="animation-delay: <%= index * 0.3 %>s"/>
                <!-- Inner dot -->
                <circle cx="<%= x %>" cy="<%= y %>" r="4" fill="#818cf8" stroke="#c7d2fe" stroke-width="1.5"/>
                <!-- City label -->
                <text x="<%= x %>" y="<%= y - 14 %>" text-anchor="middle" fill="#e0e7ff" font-size="11" font-weight="600"><%= city.name %></text>
                <!-- Time label (updated via JS) -->
                <text x="<%= x %>" y="<%= y + 22 %>" text-anchor="middle" fill="#a5b4fc" font-size="9" id="time-<%= city.id %>">--:--</text>
              </g>
            <% }); %>
          </svg>
        </div>
      </div>

      <!-- Callout (hover tooltip) -->
      <div id="weather-callout" class="callout">
        <div class="bg-slate-800/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-indigo-500/30 p-5 min-w-[240px]">
          <div class="flex items-center justify-between mb-3">
            <h3 id="callout-city" class="text-white font-bold text-lg"></h3>
            <span id="callout-emoji" class="text-3xl"></span>
          </div>
          <p id="callout-desc" class="text-indigo-300 text-sm mb-3"></p>
          <div class="grid grid-cols-2 gap-3">
            <div class="bg-white/5 rounded-lg p-2 text-center">
              <p class="text-xs text-gray-400">Temp</p>
              <p id="callout-temp" class="text-white font-bold text-lg"></p>
            </div>
            <div class="bg-white/5 rounded-lg p-2 text-center">
              <p class="text-xs text-gray-400">Humidity</p>
              <p id="callout-humidity" class="text-white font-bold text-lg"></p>
            </div>
            <div class="bg-white/5 rounded-lg p-2 text-center">
              <p class="text-xs text-gray-400">Wind</p>
              <p id="callout-wind" class="text-white font-bold text-lg"></p>
            </div>
            <div class="bg-white/5 rounded-lg p-2 text-center">
              <p class="text-xs text-gray-400">Local Time</p>
              <p id="callout-time" class="text-white font-bold text-sm"></p>
            </div>
          </div>
          <div class="mt-3 text-center">
            <p class="text-xs text-indigo-400">Click for detailed forecast →</p>
          </div>
        </div>
      </div>
    </div>

    <!-- City Cards Grid -->
    <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-6xl mx-auto" id="city-cards">
      <% cities.forEach(function(city) { %>
        <a href="/city/<%= city.id %>" target="_blank" class="block backdrop-blur-xl bg-white/5 rounded-2xl p-4 border border-white/10 hover:border-indigo-500/50 hover:bg-white/10 transition-all duration-200 group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-white font-semibold text-sm"><%= city.name %></span>
            <span id="card-emoji-<%= city.id %>" class="text-xl">⏳</span>
          </div>
          <p class="text-xs text-gray-400"><%= city.continent %></p>
          <p id="card-time-<%= city.id %>" class="text-indigo-300 text-sm font-mono mt-1">--:--</p>
          <p id="card-temp-<%= city.id %>" class="text-white font-bold text-lg mt-1">--°C</p>
        </a>
      <% }); %>
    </div>

    <!-- Footer -->
    <div class="mt-8 max-w-6xl mx-auto">
      <div class="backdrop-blur-xl bg-white/5 rounded-2xl p-5 border border-white/10">
        <div class="flex flex-col md:flex-row items-center justify-between space-y-3 md:space-y-0">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-lg flex items-center justify-center">
              <span class="text-sm">🌐</span>
            </div>
            <div>
              <p class="text-sm font-semibold text-white/80">Powered by Open-Meteo</p>
              <p class="text-xs text-gray-400">Free open-source weather API</p>
            </div>
          </div>
          <button onclick="location.reload()" class="inline-flex items-center space-x-2 px-4 py-2 bg-gradient-to-r from-indigo-500 to-purple-600 text-white rounded-lg hover:from-indigo-600 hover:to-purple-700 transition-all duration-200 shadow-md text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            <span>Refresh</span>
          </button>
        </div>
      </div>
    </div>
  </main>

  <script>
    // City data from server
    const cities = <%- JSON.stringify(cities) %>;
    let weatherData = {};

    // Update local times for all cities
    function updateCityTimes() {
      cities.forEach(city => {
        try {
          const now = new Date();
          const timeStr = now.toLocaleTimeString('en-US', {
            timeZone: city.timezone,
            hour: '2-digit',
            minute: '2-digit',
            hour12: true
          });
          const timeEl = document.getElementById('time-' + city.id);
          if (timeEl) timeEl.textContent = timeStr;
          const cardTimeEl = document.getElementById('card-time-' + city.id);
          if (cardTimeEl) cardTimeEl.textContent = timeStr;
        } catch (e) {
          // Timezone not supported in this browser
        }
      });
    }

    // Fetch weather data
    async function fetchWeather() {
      try {
        const response = await fetch('/api/weather');
        const data = await response.json();
        weatherData = {};
        data.forEach(item => {
          weatherData[item.id] = item;
          // Update city cards
          const emojiEl = document.getElementById('card-emoji-' + item.id);
          const tempEl = document.getElementById('card-temp-' + item.id);
          if (emojiEl && item.emoji) emojiEl.textContent = item.emoji;
          if (tempEl && item.temperature !== null) tempEl.textContent = item.temperature + '°C';
        });
      } catch (e) {
        console.error('Failed to fetch weather:', e);
      }
    }

    // Callout handling
    const callout = document.getElementById('weather-callout');
    const mapContainer = document.getElementById('map-container');
    let calloutVisible = false;
    let activeCity = null;

    document.querySelectorAll('.city-marker').forEach(marker => {
      marker.addEventListener('mouseenter', function(e) {
        const cityId = this.dataset.cityId;
        const weather = weatherData[cityId];
        if (!weather) return;

        activeCity = cityId;
        document.getElementById('callout-city').textContent = weather.name;
        document.getElementById('callout-emoji').textContent = weather.emoji || '🌡️';
        document.getElementById('callout-desc').textContent = weather.description || 'Loading...';
        document.getElementById('callout-temp').textContent = weather.temperature !== null ? weather.temperature + '°C' : '--';
        document.getElementById('callout-humidity').textContent = weather.humidity !== undefined ? weather.humidity + '%' : '--';
        document.getElementById('callout-wind').textContent = weather.windSpeed !== undefined ? weather.windSpeed + ' km/h' : '--';
        
        const now = new Date();
        try {
          const timeStr = now.toLocaleTimeString('en-US', {
            timeZone: weather.timezone,
            hour: '2-digit',
            minute: '2-digit',
            hour12: true
          });
          document.getElementById('callout-time').textContent = timeStr;
        } catch (err) {
          document.getElementById('callout-time').textContent = '--:--';
        }

        // Position callout near the marker
        const svg = document.getElementById('world-map');
        const svgRect = svg.getBoundingClientRect();
        const containerRect = mapContainer.getBoundingClientRect();
        
        const circle = this.querySelector('circle');
        const cx = parseFloat(circle.getAttribute('cx'));
        const cy = parseFloat(circle.getAttribute('cy'));
        
        const scaleX = svgRect.width / 1000;
        const scaleY = svgRect.height / 500;
        
        let left = (svgRect.left - containerRect.left) + (cx * scaleX) + 15;
        let top = (svgRect.top - containerRect.top) + (cy * scaleY) - 80;

        // Keep callout within bounds
        if (left + 260 > containerRect.width) {
          left = left - 280;
        }
        if (top < 0) top = 10;

        callout.style.left = left + 'px';
        callout.style.top = top + 'px';
        callout.classList.add('visible');
        calloutVisible = true;
      });

      marker.addEventListener('mouseleave', function() {
        setTimeout(() => {
          if (!callout.matches(':hover')) {
            callout.classList.remove('visible');
            calloutVisible = false;
            activeCity = null;
          }
        }, 100);
      });

      // Click to open city detail page
      marker.addEventListener('click', function() {
        const cityId = this.dataset.cityId;
        window.open('/city/' + cityId, '_blank');
      });
    });

    // Hide callout when leaving it
    callout.addEventListener('mouseleave', function() {
      callout.classList.remove('visible');
      calloutVisible = false;
      activeCity = null;
    });

    // Click on callout to open city page
    callout.addEventListener('click', function() {
      if (activeCity) {
        window.open('/city/' + activeCity, '_blank');
      }
    });

    // Initialize
    updateCityTimes();
    setInterval(updateCityTimes, 1000);
    fetchWeather();
    // Refresh weather every 5 minutes
    setInterval(fetchWeather, 300000);
  </script>
</body>
</html>
